using Microsoft.EntityFrameworkCore;
using mrsexam_backend.Models;

namespace mrsexam_backend
{
    public sealed class MrsexamContext : DbContext
    {
        public MrsexamContext(DbContextOptions<MrsexamContext> options)
            : base(options)
        {
        }

        public DbSet<Center> Centres { get; set; } = null!;
        public DbSet<Region> Regions { get; set; } = null!;
        public DbSet<User> Users { get; set; } = null!;
        public DbSet<Session> Sessions { get; set; } = null!;
        public DbSet<Parameter> Parameters { get; set; } = null!;
        public DbSet<Exam> Exams { get; set; } = null!;
        public DbSet<District> Districts { get; set; } = null!;
        public DbSet<Grade> Grades { get; set; } = null!;
        public DbSet<Institution> Institutions { get; set; } = null!;
        public DbSet<Result> Results { get; set; } = null!;

        // Optionally override to configure the model:
        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            base.OnModelCreating(modelBuilder);

            modelBuilder.Entity<Center>(entity =>
            {
                entity.HasKey(e => e.CentreNo);
                entity.Property(e => e.CentreNo).HasMaxLength(10).IsRequired();
                entity.Property(e => e.AddressTo).HasMaxLength(50);
                entity.Property(e => e.CentreName).HasMaxLength(100);
                entity.Property(e => e.DistrictName).HasMaxLength(50);
                entity.Property(e => e.Add1).HasMaxLength(50);
                entity.Property(e => e.Add2).HasMaxLength(50);
                entity.Property(e => e.City).HasMaxLength(35);
                entity.Property(e => e.Pincode).HasMaxLength(6);
                entity.Property(e => e.Phone).HasMaxLength(15);
                entity.Property(e => e.PanditFlag).HasMaxLength(1).HasDefaultValue("N");
                entity.Property(e => e.CloseFlag).HasMaxLength(1).HasDefaultValue("N");
            });

            modelBuilder.Entity<Region>(entity =>
            {
                entity.ToTable("REGION");
                entity.HasKey(e => e.RegionNo);
                entity.Property(e => e.RegionNo).HasDefaultValue(0).IsRequired();
                entity.Property(e => e.RegionName).HasMaxLength(50);
                entity.Property(e => e.SeatRegionNo).HasDefaultValue(0);
                entity.Property(e => e.RegionNameEng).HasMaxLength(50);
            });

            modelBuilder.Entity<User>(entity =>
            {
                entity.ToTable("USERS");
                entity.HasKey(e => e.UserId);
                entity.Property(e => e.UserId).HasMaxLength(10).IsRequired();
                entity.Property(e => e.Password).HasMaxLength(10);
                entity.Property(e => e.UserKey).HasMaxLength(5);
                entity.HasIndex(e => e.UserKey).HasDatabaseName("USERS$KEY");
            });

            modelBuilder.Entity<Session>(entity =>
            {
                entity.ToTable("SESSION");
                entity.HasKey(e => e.SessionNo);
                entity.Property(e => e.SessionNo).HasDefaultValue(0).IsRequired();
                entity.Property(e => e.ResultDate);
                entity.Property(e => e.ResultPrinted).HasMaxLength(1).HasDefaultValue("N");
                entity.Property(e => e.CloseFlag).HasMaxLength(1).HasDefaultValue("N");
                entity.Property(e => e.Month).HasMaxLength(20);
                entity.Property(e => e.Defa).HasMaxLength(1);
                entity.Property(e => e.ResgenPandit).HasMaxLength(1);
                entity.Property(e => e.ResgenPraveen).HasMaxLength(1);
                entity.Property(e => e.ResgenPrabodh).HasMaxLength(1);
                entity.Property(e => e.ResgenSubodh).HasMaxLength(1);
                entity.Property(e => e.ResgenPraveshika).HasMaxLength(1);
                entity.Property(e => e.ResgenPrathamik).HasMaxLength(1);
                entity.Property(e => e.ResgenBalbodhini).HasMaxLength(1);
                entity.Property(e => e.Backup).HasMaxLength(1).HasDefaultValue("N");
            });

            modelBuilder.Entity<Parameter>(entity =>
            {
                entity.ToTable("PARAMETER");
                entity.HasKey(e => e.ParameterId);
                entity.Property(e => e.CentreAddressTo).HasMaxLength(50);
                entity.Property(e => e.SessionMonth11).HasMaxLength(20);
                entity.Property(e => e.SessionMonth12).HasMaxLength(20);
                entity.Property(e => e.SessionMonth21).HasMaxLength(20);
                entity.Property(e => e.SessionMonth22).HasMaxLength(20);
                entity.Property(e => e.InstName).HasMaxLength(50);
                entity.Property(e => e.InstAdd).HasMaxLength(55);
                entity.Property(e => e.ListOfCentres).HasMaxLength(50);
                entity.Property(e => e.CentreNo).HasMaxLength(20);
                entity.Property(e => e.CentreName).HasMaxLength(20);
                entity.Property(e => e.CentreAdd).HasMaxLength(20);
                entity.Property(e => e.PageNo).HasMaxLength(20);
                entity.Property(e => e.RightHead).HasMaxLength(50);
                entity.Property(e => e.CentreHeadPandit).HasMaxLength(200);
                entity.Property(e => e.Centre).HasMaxLength(50);
                entity.Property(e => e.HeadingAttsheet);
                entity.Property(e => e.RollNo).HasMaxLength(50);
                entity.Property(e => e.Paper1).HasMaxLength(50);
                entity.Property(e => e.Paper2).HasMaxLength(50);
                entity.Property(e => e.Paper3).HasMaxLength(50);
                entity.Property(e => e.Paper4).HasMaxLength(50);
                entity.Property(e => e.Paper5).HasMaxLength(50);
                entity.Property(e => e.Paper6).HasMaxLength(50);
                entity.Property(e => e.Date).HasMaxLength(50);
                entity.Property(e => e.RightFoot).HasMaxLength(200);
                entity.Property(e => e.From).HasMaxLength(50);
                entity.Property(e => e.To).HasMaxLength(50);
                entity.Property(e => e.CentreHeadPraveen).HasMaxLength(200);
                entity.Property(e => e.ApplicantName).HasMaxLength(50);
                entity.Property(e => e.ExamCentre).HasMaxLength(50);
                entity.Property(e => e.RollNo1).HasMaxLength(50);
                entity.Property(e => e.Session).HasMaxLength(50);
                entity.Property(e => e.SsmaTimeStamp).IsRowVersion();
            });

            modelBuilder.Entity<Exam>(entity =>
            {
                entity.ToTable("EXAM");
                entity.HasKey(e => e.ExamNo);
                entity.Property(e => e.ExamNo).HasDefaultValue(0).IsRequired();
                entity.Property(e => e.ExamName).HasMaxLength(50);
                entity.Property(e => e.SessionNo).HasDefaultValue(0);
                entity.Property(e => e.NoOfPapers).HasDefaultValue(0);
                entity.Property(e => e.Fees).HasDefaultValue(0);
                entity.Property(e => e.AttSheetPrinted).HasMaxLength(1);
                entity.Property(e => e.ResultGenFlag).HasMaxLength(1).HasDefaultValue("N");
                entity.Property(e => e.MinTotalKhand1).HasDefaultValue(125);
                entity.Property(e => e.MinTotalKhand2).HasDefaultValue(70);
                entity.Property(e => e.Class1Marks).HasDefaultValue(0);
                entity.Property(e => e.Class2Marks).HasDefaultValue(0);
                entity.Property(e => e.Class3Marks).HasDefaultValue(0);
                entity.Property(e => e.DistMarks).HasDefaultValue(0);
            });

            modelBuilder.Entity<District>(entity =>
            {
                entity.ToTable("DISTRICT");
                entity.HasKey(e => e.DistrictName);
                entity.Property(e => e.DistrictName).HasMaxLength(50).IsRequired();
                entity.Property(e => e.RegionNo).HasDefaultValue(0);
                entity.Property(e => e.DistrictCity).HasMaxLength(50);
                entity.Property(e => e.ShortName).HasMaxLength(10);
                entity.Property(e => e.SeatDistrictNo).HasDefaultValue(0);

                entity.HasOne<Region>()
                      .WithMany()
                      .HasForeignKey(d => d.RegionNo)
                      .HasConstraintName("DISTRICT_REGION_FK");
            });

            modelBuilder.Entity<Grade>(entity =>
            {
                entity.ToTable("GRADE");
                entity.HasKey(e => e.GradeNo);
                entity.Property(e => e.GradeNo).HasMaxLength(10).IsRequired();
                entity.Property(e => e.GradeName).HasMaxLength(50);
                entity.Property(e => e.GradeNameCert).HasMaxLength(50);
            });

            modelBuilder.Entity<Institution>(entity =>
            {
                entity.ToTable("INSTITUTION");
                entity.HasKey(e => e.InstitutionId);
                entity.Property(e => e.InstName).HasMaxLength(50);
                entity.Property(e => e.InstAdd).HasMaxLength(55);
            });

            modelBuilder.Entity<Result>(entity =>
            {
                entity.ToTable("RESULT");
                entity.HasKey(e => e.ResultId);
                entity.Property(e => e.ResultValue).HasColumnName("RESULT").HasMaxLength(100);
                entity.Property(e => e.Description).HasColumnName("DESC").HasMaxLength(100);
                entity.Property(e => e.Exam).HasDefaultValue((short)0);
            });
        }
    }
}