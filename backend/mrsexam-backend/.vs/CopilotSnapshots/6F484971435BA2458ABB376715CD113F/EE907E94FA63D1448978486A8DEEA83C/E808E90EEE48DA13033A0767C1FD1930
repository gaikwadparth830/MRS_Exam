        [HttpGet("user/{userId}")]
        public async Task<IActionResult> GetByUser(string userId, CancellationToken cancellationToken)
        {
            var list = await _db.FormPraveshikas.AsNoTracking()
                .Where(f => f.UserId == userId)
                .ToListAsync(cancellationToken);
